# Configuration HDFS du projet. Même principe que le cluster des TP :
# l'image apache/hadoop transforme chaque variable FICHIER.XML_cle=valeur
# en propriété du fichier de configuration correspondant.

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.permissions.enabled=false

# Deux copies de chaque bloc sur trois DataNodes : on peut en arrêter un.
HDFS-SITE.XML_dfs.replication=2

# Blocs de 16 Mo au lieu de 128 Mo : les fichiers du projet, de quelques
# dizaines à quelques centaines de Mo, se répartissent ainsi sur plusieurs blocs.
HDFS-SITE.XML_dfs.blocksize=16777216

# Un DataNode arrêté est déclaré mort en 1 minute environ au lieu de 10 min 30.
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=15000
HDFS-SITE.XML_dfs.heartbeat.interval=3
